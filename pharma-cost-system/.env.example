# ============================================================
#  大模型 / 服务配置（复制本文件为 .env 后填写，切勿把 .env 提交到公开仓库）
#  说明：不填也能运行，系统会自动降级为"本地规则引擎"离线模式。
# ============================================================

# ---------- 大模型（OpenAI 兼容接口，任选一家） ----------
# 【推荐·阿里云百炼 通义千问】注册送免费额度
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# 【备选·硅基流动】部分小模型完全免费
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 【备选·DeepSeek】
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# 可选：嵌入模型（配置后 RAG 由"BM25 关键词检索"升级为"BM25+向量"混合检索）
# LLM_EMBED_MODEL=text-embedding-v3

# ---------- 官方模拟 RPA 服务地址 ----------
RPA_BASE_URL=http://127.0.0.1:8090

# ---------- 官方模拟数据目录（一般无需填写，程序会自动查找） ----------
# PHARMA_DATA_DIR=D:/xxx/官方模拟数据/创灵境_考题模拟数据
